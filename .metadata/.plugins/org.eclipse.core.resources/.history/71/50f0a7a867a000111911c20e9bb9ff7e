#include "7SEGMENT.h"
#include "../../MCAL/DIO/DIO_interface.h"
#include "STD_TYPES.h"
#include "BIT_MATH.h"

void  SEG_Init( seg_type seg )
{
	DIO_SetPinDirection(seg.port, seg.pin, DIO_OUTPUT) ;
}

void SEG_display (seg_type seg )
{
	DIO_SetPinValue(seg.port , seg.pin , DIO_HIGH) ;
}

