u8 passord[]={1,2,3,4} ;
u8 get_pass[4] ;
u8 i =0 ;
int main(void)
{

	LCD_Init() ;
	u8 KeyPressed;
	KPD_Init();

		LCD_Send_String((u8 *)"Enter Your Pass:") ;


		while(i !=4)
		{
		    KeyPressed = KPD_u8GetPressed();

