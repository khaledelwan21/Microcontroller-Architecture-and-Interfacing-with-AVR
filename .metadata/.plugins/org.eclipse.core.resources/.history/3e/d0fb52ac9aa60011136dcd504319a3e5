#include <util/delay.h>
#include "DIO_interface.h"
#include "STD_TYPES.h"
#include "BIT_MATH.h"
#include "TIMER_interface.h"

#define F_CPU	8000000UL

void Motor_voidSetSpeed(u16 Copy_u16Speed)
{
	if (Copy_u16Speed > 999) Copy_u16Speed = 999 ;   
	OCR1A = Copy_u16Speed ;                            
}


void Motor_voidSetDirection(u8 Copy_u8Direction)
{
	if (Copy_u8Direction == 0)  
	{
		DIO_voidSetPinValue(DIO_PORTD , DIO_PIN4 , DIO_PIN_HIGH) ;
		DIO_voidSetPinValue(DIO_PORTD , DIO_PIN3 , DIO_PIN_LOW) ;
	}
	else                       
	{
		DIO_voidSetPinValue(DIO_PORTD , DIO_PIN4 , DIO_PIN_LOW) ;
		DIO_voidSetPinValue(DIO_PORTD , DIO_PIN3 , DIO_PIN_HIGH) ;
	}
}


int main()
{

	DIO_voidSetPinDirection(DIO_PORTD , DIO_PIN5 , DIO_PIN_OUTPUT) ;  //Output Compare Pin for Timer1 Channel A

	DIO_voidSetPinDirection(DIO_PORTD , DIO_PIN4 , DIO_PIN_OUTPUT) ; //N1

	DIO_voidSetPinDirection(DIO_PORTD , DIO_PIN3 , DIO_PIN_OUTPUT) ; //N2


	Timer1_voidInit() ;  // Initialize Timer1 in Fast PWM Mode with ICR1 as TOP



	while(1)
	{
	Motor_voidSetDirection(0) ;           
	u16 speed = 0 ;
	for (speed = 0; speed <= 999; speed += 10)   
	{
		Motor_voidSetSpeed(speed) ;
		_delay_ms(20) ;                   
	}

	Motor_voidSetSpeed(0) ;              
	_delay_ms(300) ;                      

	Motor_voidSetDirection(1) ;            
	for (speed = 0; speed <= 999; speed += 10)  
	{
		Motor_voidSetSpeed(speed) ;
		_delay_ms(20) ;
	}

	Motor_voidSetSpeed(0) ;
	_delay_ms(300) ;

	}

	return 0 ;
}
