#define F_CPU 8000000UL
#include <avr/io.h>
#include <util/delay.h>

int main(void)
{
    DDRB |= (1 << PD0);   // PB0 Output

    while (1)
    {
        PORTB |= (1 << PD0);   // LED ON
        _delay_ms(1000);

        PORTB &= ~(1 << PD0);  // LED OFF
        _delay_ms(1000);
    }
}
