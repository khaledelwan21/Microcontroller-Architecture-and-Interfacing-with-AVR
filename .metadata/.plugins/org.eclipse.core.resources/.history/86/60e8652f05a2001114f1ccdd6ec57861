#define F_CPU 8000000UL
#include <util/delay.h>
#include "STD_TYPES.h"
#include "DIO_interface.h"
#include "CLCD_interface.h"
#include "KEYPAD_interface.h"

int main(void)
{
    u8 KeyPressed = NOTPRESSED;

    // تهيئة الكيباد والشاشة
    KPD_Init();
    LCD_Init();

    while(1)
    {
        // قراءة الزر المضغوط
        KeyPressed = KPD_u8GetPressed();

        // إذا تم الضغط على زر فعلياً
        if(KeyPressed != NOTPRESSED)
        {
            // طباعة الحرف المضغوط مباشرة على الشاشة
            LCD_Send_Data(KeyPressed);

            // الانتظار حتى رفع اليد عن الزر لمنع تكرار طباعة نفس الحرف
            while(KPD_u8GetPressed() != NOTPRESSED);
        }
    }

    return 0;
}
