#include <util/delay.h>
#include "DIO_interface.h"
#include "STD_TYPES.h"
#define F_CPU	8000000UL

int main()
{
	DIO_SetPortDirection(PORTA ,0xFF) ;
	while(1)
	{
	DIO_SetPortValue(PORTA, 0xFF) ;
	_delay_ms(50) ;
	DIO_SetPortValue(PORTA, DIO_PIN7 , 0x00) ;
	_delay_ms(50) ;
	}
	return 0;
}
