 #include "DC_MOTOR.h"
 #include "DIO_interface.h"
 #include "STD_TYPES.h"
 #include "BIT_MATH.h"



 void DC_MOTOR_Init(motor_type motor)
 {
     DIO_SetPinDirection(motor.port,motor.pin1,OUTPUT);
     DIO_SetPinDirection(motor.port,motor.pin2,OUTPUT);
     DIO_SetPinValue(motor.port,motor.pin1,LOW);
     DIO_SetPinValue(motor.port,motor.pin2,LOW);
 }

 void DC_MOTOR_ON_CW(motor_type motor)
 {
     DIO_SetPinValue(motor.port,motor.pin1,HIGH);
     DIO_SetPinValue(motor.port,motor.pin2,LOW);
 }

 void DC_MOTOR_ON_CCW(motor_type motor)
 {
     DIO_SetPinValue(motor.port,motor.pin1,LOW);
     DIO_SetPinValue(motor.port,motor.pin2,HIGH);
 }

 void DC_MOTOR_OFF(motor_type motor)
 {
     DIO_SetPinValue(motor.port,motor.pin1,LOW);
     DIO_SetPinValue(motor.port,motor.pin2,LOW);
 }

