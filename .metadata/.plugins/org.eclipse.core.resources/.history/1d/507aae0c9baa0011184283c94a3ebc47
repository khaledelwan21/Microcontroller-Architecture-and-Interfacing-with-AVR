#include <util/delay.h>
#include <avr/interrupt.h>
#include "DIO_interface.h"
#include "DIO_private.h"
#include "SPI_interface.h"
#include "STD_TYPES.h"
#include "BIT_MATH.h"

#define F_CPU	8000000UL

u8 DataRecieve = 0;

int main()
{
	DIO_SetPinDirection(PORTB, PIN5, DIO_INPUT);   // MOSI
	DIO_SetPinDirection(PORTB, PIN6, DIO_OUTPUT);  // MISO
	DIO_SetPinDirection(PORTB, PIN7, DIO_INPUT);   // SCK
	DIO_SetPinDirection(PORTB, PIN4, DIO_INPUT);   // SS
	DIO_SetPin_PullUp(PORTB, PIN4, PullUp);

	DIO_SetPinDirection(PORTA, PIN0, DIO_OUTPUT);  // led

	SPI_VoidInit();

	while (1)
	{
		SPI_u8Tranceive(5, &DataRecieve);

		if (DataRecieve == 10)
		{
			DIO_SetPinValue(PORTA, PIN0, DIO_HIGH);
		}

		_delay_ms(1000);
	}

	return 0;
}
