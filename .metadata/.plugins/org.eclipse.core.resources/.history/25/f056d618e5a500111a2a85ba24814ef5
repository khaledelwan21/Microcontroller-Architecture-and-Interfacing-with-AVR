#define F_CPU	8000000UL

u32 counter=0 ;
void ToggleLed(void)
{
	counter++ ;
	if(counter==10000)
	{
	SET_BIT( DIO_PORTB, DIO_PIN6) ;
		counter=0 ;
	}

}

led_type LED[8] = {
     { .port = PORTB, .pin = DIO_PIN0 },
     { .port = PORTB, .pin = DIO_PIN1 },
     { .port = PORTB, .pin = DIO_PIN2 },
     { .port = PORTB, .pin = DIO_PIN3 },
     { .port = PORTB, .pin = DIO_PIN4 },
     { .port = PORTB, .pin = DIO_PIN5 },
     { .port = PORTB, .pin = DIO_PIN6 },
     { .port = PORTB, .pin = DIO_PIN7 }
 };



int main()
{


	for (u8 i = 0; i < 8; i++)
	  {
		 LED_Init(LED[i]);
	  }
	TIMER0_voidInit() ;
	TIMER_u8SetCallBack( ToggleLed,TIMER0_OVF_VECTOR_ID) ;
	GI_ENABLE();

	while(1)
	{

	}


	return 0;
}
