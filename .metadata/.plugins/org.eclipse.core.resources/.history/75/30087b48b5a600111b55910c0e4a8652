/*
 * main.c
 * Motor Speed & Direction Control via Potentiometer (ADC)
 */
#include <util/delay.h>
#include <avr/interrupt.h>
#include "DIO_interface.h"
#include "ADC_interface.h"
#include "TIMER_interface.h"
#include "STD_TYPES.h"
#include "BIT_MATH.h"

#define F_CPU			8000000UL

#define MOTOR_MAX_SPEED		999

#define POT_MID_POINT 512
#define POT_DEAD_ZONE 20

volatile u16 PotReading = 0 ;

/*----------------------------------------------------------------*/

void Motor_voidSetSpeed(u16 Copy_u16Speed)
{
	if (Copy_u16Speed > MOTOR_MAX_SPEED)
	{
		Copy_u16Speed = MOTOR_MAX_SPEED ;
	}
	TIMER1_voidSetCTCA(Copy_u16Speed) ;
}

void Motor_voidSetDirection(u8 Copy_u8Direction)
{
	if (Copy_u8Direction == 0)
	{
		DIO_SetPinValue(PORTC , DIO_PIN0 , DIO_HIGH) ;   /*N1*/
		DIO_SetPinValue(PORTC , DIO_PIN1 , DIO_LOW)  ;   /*N2*/
	}
	else
	{
		DIO_SetPinValue(PORTC , DIO_PIN0 , DIO_LOW)  ;
		DIO_SetPinValue(PORTC , DIO_PIN1 , DIO_HIGH) ;
	}
}

void Motor_voidStop(void)
{
	DIO_SetPinValue(PORTC , DIO_PIN1 , DIO_LOW) ;
	DIO_SetPinValue(PORTC , DIO_PIN0 , DIO_LOW) ;
	Motor_voidSetSpeed(0) ;
}

/*----------------------------------------------------------------*/
void ADC_ReadingReady(void)
{
    u16 Local_u16Speed;

    if (PotReading < (POT_MID_POINT - POT_DEAD_ZONE))
    {
        Motor_voidSetDirection(0);

        Local_u16Speed =
            ((u32)((POT_MID_POINT - POT_DEAD_ZONE) - PotReading)
            * MOTOR_MAX_SPEED)
            / (POT_MID_POINT - POT_DEAD_ZONE);

        Motor_voidSetSpeed(Local_u16Speed);
    }

    else if (PotReading > (POT_MID_POINT + POT_DEAD_ZONE))
    {
        Motor_voidSetDirection(1);

        Local_u16Speed =
            ((u32)(PotReading - (POT_MID_POINT + POT_DEAD_ZONE))
            * MOTOR_MAX_SPEED)
            / (1023 - (POT_MID_POINT + POT_DEAD_ZONE));

        Motor_voidSetSpeed(Local_u16Speed);
    }

    else
    {
        Motor_voidStop();
    }
}
/*----------------------------------------------------------------*/

int main()
{
	/*Direction Pins*/
	DIO_SetPinDirection(PORTC , DIO_PIN1 , DIO_OUTPUT) ;   /*N1*/
	DIO_SetPinDirection(PORTC , DIO_PIN0 , DIO_OUTPUT) ;   /*N2*/

	DIO_SetPinDirection(PORTD , DIO_PIN5 , DIO_OUTPUT) ;

	/*Potentiometer Input Pin*/
	DIO_SetPinDirection(PORTA , DIO_PIN0 , DIO_INPUT) ;

	TIMER1_voidInit() ;
	ADC_u8SetPrescaler(ADC_PRE_2) ;

	ADC_voidInit() ;

	ADC_u8StartFreeRunningAsynch(ADC_CHANNEL0, (u16*)&PotReading, ADC_ReadingReady) ;

	sei() ;

	while(1)
	{
	}

	return 0 ;
}
