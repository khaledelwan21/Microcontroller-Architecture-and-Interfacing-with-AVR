#define F_CPU 8000000UL
#include <util/delay.h>

#include "CLCD_interface.h"
#include "CLCD_config.h"
#include "DIO_interface.h"

void LCD_Init(void)
{
	_delay_ms(50);
	DIO_SetPortDirection(LCD_DATA_PORT, 0xFF);
	DIO_SetPinDirection(LCD_CONTROL_PORT, LCD_RS, DIO_OUTPUT);
	DIO_SetPinDirection(LCD_CONTROL_PORT, LCD_RW, DIO_OUTPUT);
	DIO_SetPinDirection(LCD_CONTROL_PORT, LCD_EN, DIO_OUTPUT);

	DIO_SetPinValue(LCD_CONTROL_PORT, LCD_RW, DIO_LOW);

	LCD_Send_Command(EIGHT_BITS);
	_delay_ms(5);
	LCD_Send_Command(EIGHT_BITS);
	_delay_ms(1);
	LCD_Send_Command(EIGHT_BITS);
	_delay_ms(1);

	LCD_Send_Command(lcd_DisplayOn_CursorOff);
	_delay_ms(1);

	LCD_Clear_Screen();
	_delay_ms(2);

	LCD_Send_Command(lcd_EntryMode);
	_delay_ms(1);
}

void LCD_Send_Data(u8 data)
{
	DIO_SetPinValue(LCD_CONTROL_PORT, LCD_RS, DIO_HIGH);
	DIO_SetPinValue(LCD_CONTROL_PORT, LCD_RW, DIO_LOW);
	DIO_SetPortValue(LCD_DATA_PORT, data);
	LCD_Send_Falling_Edge();
	_delay_ms(2);
}

void LCD_Send_Command(u8 command)
{
	DIO_SetPinValue(LCD_CONTROL_PORT, LCD_RS, DIO_LOW);
	DIO_SetPinValue(LCD_CONTROL_PORT, LCD_RW, DIO_LOW);
	DIO_SetPortValue(LCD_DATA_PORT, command);
	LCD_Send_Falling_Edge();
	_delay_ms(2);
}

void LCD_Send_String(u8 *string)
{
	u8 LOC_u8Iterator = 0;

	while (string[LOC_u8Iterator] != '\0')
	{
		LCD_Send_Data(string[LOC_u8Iterator]);
		LOC_u8Iterator++;
	}
}

void LCD_Send_Number(u32 Number)
{
	u64 LOC_u64Reversed = 1;

	if (Number == 0)
	{
		LCD_Send_Data('0');
	}
	else
	{
		while (Number != 0)
		{
			LOC_u64Reversed = (LOC_u64Reversed * 10) + (Number % 10);
			Number /= 10;
		}
		while (LOC_u64Reversed != 1)
		{
			LCD_Send_Data((LOC_u64Reversed % 10) + 48);
			LOC_u64Reversed /= 10;
		}
	}
}

void LCD_Clear_Screen(void)
{
	LCD_Send_Command(lcd_Clear);
	_delay_ms(2);
}

void LCD_Send_Falling_Edge(void)
{
	DIO_SetPinValue(LCD_CONTROL_PORT, LCD_EN, DIO_HIGH);
	_delay_ms(1);
	DIO_SetPinValue(LCD_CONTROL_PORT, LCD_EN, DIO_LOW);
	_delay_ms(1);
}

void LCD_Set_Position(u8 Copy_u8Row, u8 Copy_u8Col)
{
	u8 LOC_u8data;

	if (Copy_u8Row > 2 || Copy_u8Row < 1 || Copy_u8Col > 16 || Copy_u8Col < 1)
	{
		LOC_u8data = lcd_SetCursor;
	}
	else if (Copy_u8Row == CLCD_ROW_1)
	{
		LOC_u8data = (lcd_SetCursor) + (Copy_u8Col - 1);
	}
	else if (Copy_u8Row == CLCD_ROW_2)
	{
		LOC_u8data = (lcd_SetCursor) + (64) + (Copy_u8Col - 1);
	}
	LCD_Send_Command(LOC_u8data);
	_delay_ms(1);
}

void LCD_Shift_Display(u8 Copy_u8Direction, u8 Copy_u8Steps, u16 Copy_u16Delay_ms)
{
	u8 LOC_u8Command;
	u8 LOC_u8Iterator;

	if (Copy_u8Direction == LCD_SHIFT_RIGHT)
	{
		LOC_u8Command = lcd_ShiftDisplayRight;
	}
	else
	{
		LOC_u8Command = lcd_ShiftDisplayLeft;
	}

	for (LOC_u8Iterator = 0; LOC_u8Iterator < Copy_u8Steps; LOC_u8Iterator++)
	{
		LCD_Send_Command(LOC_u8Command);
		_delay_ms(Copy_u16Delay_ms);
	}
}

void LCD_Shift_String(u8 *Copy_u8String, u8 Copy_u8Row, u8 Copy_u8Direction, u8 Copy_u8Steps, u16 Copy_u16Delay_ms)
{
	u8 LOC_u8Iterator;
	u8 LOC_u8StartCol;

	if (Copy_u8Direction == LCD_SHIFT_LEFT)
	{
		for (LOC_u8Iterator = 0; LOC_u8Iterator < Copy_u8Steps; LOC_u8Iterator++)
		{
			LCD_Clear_Screen();
			LOC_u8StartCol = 16 - LOC_u8Iterator;
			LCD_Set_Position(Copy_u8Row, LOC_u8StartCol);
			LCD_Send_String(Copy_u8String);
			_delay_ms(Copy_u16Delay_ms);
		}
	}
	else if (Copy_u8Direction == LCD_SHIFT_RIGHT)
	{
		for (LOC_u8Iterator = 0; LOC_u8Iterator < Copy_u8Steps; LOC_u8Iterator++)
		{
			LCD_Clear_Screen();
			LOC_u8StartCol = 1 + LOC_u8Iterator;
			LCD_Set_Position(Copy_u8Row, LOC_u8StartCol);
			LCD_Send_String(Copy_u8String);
			_delay_ms(Copy_u16Delay_ms);
		}
	}
}
void LCD_Send_SignedNumber(s32 Copy_s32Number)
{


    if (Copy_s32Number == 0)
    {
        LCD_Send_Data('0');
        return;
    }

    if (Copy_s32Number < 0)
    {
        LCD_Send_Data('-');
        Copy_s32Number = -Copy_s32Number;
    }
    LCD_Send_Number(Copy_s32Number) ;

}
