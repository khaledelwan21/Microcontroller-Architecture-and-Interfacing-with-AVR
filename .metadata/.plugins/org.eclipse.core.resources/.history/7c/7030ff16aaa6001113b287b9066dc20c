#include <util/delay.h>
#include "DIO_interface.h"
#include "STD_TYPES.h"
#include "ADC_interface.h"
#include "BIT_MATH.h"
#include "TIMER_interface.h"

#define F_CPU	8000000UL

void Motor_voidSetSpeed(u16 Copy_u16Speed)
{
	if (Copy_u16Speed > 999) Copy_u16Speed = 999 ;   
	TIMER1_voidSetCTCA(Copy_u16Speed) ;
}


void Motor_voidSetDirection(u8 Copy_u8Direction)
{
	if (Copy_u8Direction == 0)  
	{
		DIO_SetPinValue(PORTC , DIO_PIN1 , DIO_HIGH) ;
		DIO_SetPinValue(PORTC , DIO_PIN0 , DIO_LOW) ;
	}
	else                       
	{
		DIO_SetPinValue(PORTC , DIO_PIN1 , DIO_LOW) ;
		DIO_SetPinValue(PORTC , DIO_PIN0 , DIO_HIGH) ;
	}
}


int main()
{

	DIO_SetPinDirection(PORTD , DIO_PIN5 , DIO_OUTPUT) ;  //Output Compare Pin for Timer1 Channel A

	DIO_SetPinDirection(PORTC , DIO_PIN1 , DIO_OUTPUT) ; //N1

	DIO_SetPinDirection(PORTC , DIO_PIN0 , DIO_OUTPUT) ; //N2


	TIMER1_voidInit() ;  // Initialize Timer1 in Fast PWM Mode with ICR1 as TOP



	while(1)
	{
	Motor_voidSetDirection(0) ;           
	u16 speed = 0 ;
	for (speed = 0; speed <= 999; speed += 10)   
	{
		Motor_voidSetSpeed(speed) ;
		_delay_ms(20) ;                   
	}

	Motor_voidSetSpeed(0) ;

	_delay_ms(300) ;                      

	Motor_voidSetDirection(1) ;            
	for (speed = 0; speed <= 999; speed += 10)  
	{
		Motor_voidSetSpeed(speed) ;
		_delay_ms(20) ;
	}

	Motor_voidSetSpeed(0) ;
	_delay_ms(300) ;

	}

	return 0 ;
}
