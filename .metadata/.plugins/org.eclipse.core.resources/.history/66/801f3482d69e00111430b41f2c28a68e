#include <util/delay.h>
#include "DIO_interface.h"
#include "STD_TYPES.h"
#define F_CPU	8000000UL

int main()
{
	DIO_SetPinDirection(PORTA , DIO_PIN7 , DIO_OUTPUT) ;
	while(1)
	{
	DIO_SetPinValue(PORTA, DIO_PIN7 , DIO_HIGH) ;
	_delay_ms(5000) ;
	DIO_SetPinValue(PORTA, DIO_PIN7 , DIO_LOW) ;
	_delay_ms(5000) ;
	}
	return 0;
}
