u8 passord[]="7777" ;
u8 get_pass[]="" ;
int main(void)
{

	LCD_Init() ;
	u8 KeyPressed;
	KPD_Init();

	while(1)
	{
		LCD_Send_String((u8 *)"Enter Your Pass:") ;
		LCD_Set_Position(2,1) ;

		for(int i=0, i<3, i++)
		{
		    KeyPressed = KPD_u8GetPressed();

		    if(KeyPressed != NOTPRESSED)
		    {
		        LCD_Send_Data(KeyPressed);

		        while(KPD_u8GetPressed() != NOTPRESSED);	// stuck here until release the switch
		    }
		}

	}
    return 0;
}

